NEXT_PUBLIC_SITE_URL=https://noam.pe

# Compose uses the internal service name "postgres". Replace both passwords with
# the same strong random value and percent-encode special URL characters.
POSTGRES_DB=noam
POSTGRES_USER=noam
POSTGRES_PASSWORD=CHANGE_WITH_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://noam:CHANGE_WITH_A_LONG_RANDOM_SECRET@postgres:5432/noam
NOAM_DB_SSL=false

NOAM_ADMIN_TOKEN=
NOAM_ALLOW_LEGACY_ADMIN=false
NOAM_AUTH_ENCRYPTION_KEY=CHANGE_WITH_64_HEX_CHARACTERS

RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM="NOAM <hola@noam.pe>"
NOAM_CAMPAIGN_ACTOR_EMAIL=

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
NOAM_IMAGE_TAG=latest
