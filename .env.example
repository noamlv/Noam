# Local: http://localhost:3000. Production: https://noam.pe
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional in local development. If missing, leads are stored in .data/leads.json.
# Works with any standard Postgres instance: local Docker, VPS, Neon, Railway, Supabase Postgres, etc.
DATABASE_URL=postgres://noam:noam@localhost:5433/noam
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Local Docker: false. Production: true.
NOAM_DB_SSL=false

# Temporary compatibility only. Never enable legacy access in production after creating individual users.
NOAM_ADMIN_TOKEN=
NOAM_ALLOW_LEGACY_ADMIN=false

# Required for TOTP MFA. Generate 32 random bytes, for example:
# node -p 'require("node:crypto").randomBytes(32).toString("hex")'
NOAM_AUTH_ENCRYPTION_KEY=

# Optional. If present, every new lead triggers a notification and newsletter requests receive a confirmation link.
RESEND_API_KEY=
LEAD_NOTIFY_TO=
# In production use a verified noam.pe sender, for example NOAM <hola@noam.pe>.
LEAD_NOTIFY_FROM=NOAM <onboarding@resend.dev>

# Identity responsible for audited scheduled newsletter dispatches.
NOAM_CAMPAIGN_ACTOR_EMAIL=
